# Copie ce fichier en .env et remplis les valeurs

# JID du groupe WhatsApp (ex: 123456789-123456@g.us)
BOT_GROUP_JID=

# JIDs des admins humains, séparés par des virgules
ADMIN_JIDS=

# Chemins de données
DB_PATH=data/beerbot.db
SESSION_PATH=data/session.db

# true tant que la modération n'est pas validée : log les sanctions sans agir
DRY_RUN=true

# Réglages de modération
GRACE_PERIOD_SECONDS=90
# Délai laissé pour envoyer le numéro après une photo postée sans légende
CAPTION_GRACE_PERIOD_SECONDS=300
TIER1_HOURS=24
TIER2_DAYS=7
PRESCRIPTION_DAYS=90
